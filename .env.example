# Os JIDs aparecem na listagem inicial da ferramenta.
SOURCE_GROUP_JID="grupo-origem@g.us"
DESTINATION_GROUP_JID="grupo-destino@g.us"

# Opcional: números/JIDs separados por vírgula, ponto e vírgula ou nova linha.
EXCLUDED_JIDS="5593999990000,5593999990001"

# Quantos candidatos mostrar no terminal (1 a 50).
PREVIEW_LIMIT="5"

# Modo padrão e seguro.
REAL_RUN="false"

# Alvo dirigido individual: número conhecido/autorizado, com DDI + DDD + número.
# A ferramenta tenta resolver PN -> LID e confirma se ele é candidato atual.
TARGET_PHONE="5593999990000"

# Alternativa legada individual: JID/número exato já identificado no DRY RUN.
# Não use junto com TARGET_PHONE, TARGET_PHONES ou AUTO_BATCH.
TARGET_PARTICIPANT=""

# Lote manual controlado: somente números explicitamente autorizados.
# Use apenas com BATCH_RUN=true.
TARGET_PHONES="5593999990000,5593999990001"
BATCH_RUN="false"

# Fila automática controlada (2 a 5 participantes por execução).
# AUTO_BATCH exige uma allowlist de opt-in em CSV/TXT. Só entram na fila
# participantes que estejam no Grupo A, tenham PN conhecido e também apareçam
# neste arquivo de pessoas que autorizaram a entrada no Grupo B.
AUTO_BATCH="false"
OPT_IN_FILE="data/opt-in.csv"

# Opcional: nome exato da coluna que contém o telefone no CSV.
# Se omitido, a ferramenta reconhece nomes comuns como Telefone, WhatsApp,
# Celular, Phone, Numero de telefone etc.
OPT_IN_PHONE_COLUMN=""

# Confirmação explícita adicional para o AUTO_BATCH real.
OPT_IN_SOURCE_CONFIRMED="false"

# Individual: MAX_USERS deve ser 1.
# BATCH_RUN/AUTO_BATCH: MAX_USERS deve ser um inteiro entre 2 e 5.
MAX_USERS="1"

# Intervalo FIXO de segurança entre tentativas em lote.
# Faixa efetiva: 10000 a 120000 ms. Padrão: 15000 ms.
# Serve para limitar carga e manter a execução controlada; não há aleatorização
# nem mecanismo para contornar controles anti-spam do WhatsApp.
BATCH_DELAY_MS="15000"

# Somente quando a conta é MEMBRO no Grupo B e o metadata não informa memberAddMode.
# Se memberAddMode=false, a ferramenta bloqueia antes de chamar a API mesmo com esta flag.
ALLOW_NON_ADMIN_DESTINATION="false"
