# Os JIDs aparecem na listagem inicial da ferramenta.
SOURCE_GROUP_JID="grupo-origem@g.us"
DESTINATION_GROUP_JID="grupo-destino@g.us"

# Opcional: números/JIDs separados por vírgula, ponto e vírgula ou nova linha.
EXCLUDED_JIDS="5593999990000,5593999990001"

# Quantos candidatos mostrar no terminal (1 a 50).
PREVIEW_LIMIT="5"

# Modo padrão e seguro.
REAL_RUN="false"

# Alvo dirigido recomendado: número conhecido/autorizado, com DDI + DDD + número.
# A ferramenta tenta resolver PN -> LID e confirma se ele é candidato atual.
TARGET_PHONE="5593999990000"

# Alternativa legada: JID/número exato já identificado no DRY RUN.
# Não use junto com TARGET_PHONE.
TARGET_PARTICIPANT=""

# Somente para o teste real controlado. O código aceita exclusivamente MAX_USERS=1.
MAX_USERS="1"

# Opcional e somente para testar um Grupo B onde a conta é MEMBRO, não ADMIN.
# Não contorna permissões: o WhatsApp decide se a operação é permitida e a ferramenta para na primeira recusa.
ALLOW_NON_ADMIN_DESTINATION="false"
